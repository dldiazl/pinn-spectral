# Python cache and test artifacts.
__pycache__/
*.py[cod]
.pytest_cache/

# Local environments and editor/tool files.
.venv/
venv/
.env
.vscode/
.idea/
.claude/

# Generated numerical data, models, and studies.
data/reference/*.parquet
data/numerical/*.parquet
data/nas/
data/pinn/
data/spectral/
*.db
*.pth

# Generated results: keep only figures under version control, since they are
# the lightweight, human-reviewable pipeline outputs. Metrics, postprocessed
# tables, and trained models are regenerated by the pipeline and excluded.
results/metrics/
results/models/
results/postprocess/

# Internal-only files, not part of the public repository.
run_pipeline.bat
copy2cache.bat
CHANGELOG.md

# Temporary files created by atomic workflow writes.
*.tmp
